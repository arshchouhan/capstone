PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/plantaexa
JWT_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-another-long-random-secret
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PHONE_CAMERA_PORT=5001
# Optional: your laptop Wi-Fi IP; detected automatically when omitted.
PHONE_CAMERA_HOST=
# Local crop and disease classification. Run npm run ai:download once.
AI_MODEL_PROVIDER=agrismart
TEAM_AI_PORT=8011
# Path containing data/patched_model.keras and the optional treatment CSV.
TEAM_MODEL_DIR=./models/ai/plantaexa-ai-source
# Local mode is free and downloads the model once to the Transformers.js cache.
# Use huggingface only if your account has hosted inference credits.
HF_TOKEN=
LOCAL_AI_MODEL=Xenova/vit-base-patch16-224
LOCAL_CHAT_MODEL=Xenova/flan-t5-small
# Optional: set OLLAMA_ENABLED=true after installing Ollama and pulling OLLAMA_MODEL.
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
HF_PLANT_MODEL=marwaALzaabi/plant-identification-vit
HF_DISEASE_MODEL=linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification
# Google Cloud: enable Google Calendar API; create a Web application OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/google/callback
GOOGLE_FRONTEND_ORIGIN=http://localhost:5173
# Geoapify Places: used only to show real external botanists / plant-health
# services near a scan. Keep this server-side; never expose it to Vite.
GEOAPIFY_API_KEY=
# Optional eBay Browse API. Create an eBay developer application and keep both
# values server-side. Without them, Market uses direct merchant search links.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_TOKEN_KEY=

# Optional official merchant APIs for product thumbnails
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_PARTNER_TAG=
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# Optional Copernicus Data Space OAuth client. Earth Search works without credentials.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
